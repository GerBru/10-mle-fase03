# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — ele já está no .gitignore

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development: aceita os segredos padrão (uso local e testes)
# production:  a aplicação recusa subir com segredos padrão — use em Docker/deploy
APP_ENV=development

# ── Reprodutibilidade ─────────────────────────────────────────────────────────
SEED=42

# ── Caminhos ──────────────────────────────────────────────────────────────────
DATA_PATH=data/raw/Telco_customer_churn.csv

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=churn-prediction
MLFLOW_REGISTRY_REQUIRED=true

# ── DVC remote — Google Drive (OAuth) ─────────────────────────────────────────
# Credenciais do seu OAuth Client "Desktop" (Google Cloud Console → Credentials).
# Ficam em .dvc/config.local (fora do git) via `make dvc-setup`. O login é
# interativo (navegador) no primeiro `dvc push`/`dvc pull`; o token fica em cache
# no seu usuário (~/Library/Caches/pydrive2fs), não no repositório.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MODEL_SOURCE=champion

# ── Segurança — JWT ───────────────────────────────────────────────────────────
# Obrigatório quando APP_ENV=production. Gere com: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# ── Segurança — API Key ───────────────────────────────────────────────────────
# Obrigatório quando APP_ENV=production. Gere com: openssl rand -hex 16
API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Logging (DEBUG, INFO, WARNING, ERROR) ─────────────────────────────────────
LOG_LEVEL=INFO
