# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — ele já está no .gitignore

# ── Reprodutibilidade ─────────────────────────────────────────────────────────
SEED=42

# ── Caminhos ──────────────────────────────────────────────────────────────────
MODEL_PATH=models/mlp_churn.pt
DATA_PATH=data/raw/Telco_customer_churn.csv

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=churn-prediction

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Segurança — JWT ───────────────────────────────────────────────────────────
# Em produção, gere com: openssl rand -hex 32
JWT_SECRET_KEY=churn-secret-key-fiap-tech-challenge-2026
JWT_EXPIRE_MINUTES=60

# ── Segurança — API Key ───────────────────────────────────────────────────────
# Em produção, gere com: openssl rand -hex 16
API_KEY=churn-api-key-fiap-2026

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Logging (DEBUG, INFO, WARNING, ERROR) ─────────────────────────────────────
LOG_LEVEL=INFO
