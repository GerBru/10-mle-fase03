# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — ele já está no .gitignore

# ── Ambiente ──────────────────────────────────────────────────────────────────
# development: aceita os segredos padrão (uso local e testes)
# production:  a aplicação recusa subir com segredos padrão — use em Docker/deploy
APP_ENV=development

# ── Reprodutibilidade ─────────────────────────────────────────────────────────
SEED=42

# ── Caminhos ──────────────────────────────────────────────────────────────────
DATA_PATH=data/raw/Telco_customer_churn.csv

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT_NAME=churn-prediction

# ── DVC remote — Google Drive (service account) ───────────────────────────────
# Caminho para o JSON da service account do GCP com acesso à pasta do Drive.
# O arquivo NÃO deve ser commitado (já está no .gitignore). Compartilhe a pasta
# do Drive com o e-mail da service account. Consumido pelo DVC via:
#   dvc remote modify --local storage gdrive_service_account_json_file_path $GDRIVE_SA_JSON
GDRIVE_SA_JSON=gdrive-service-account.json

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Segurança — JWT ───────────────────────────────────────────────────────────
# Obrigatório quando APP_ENV=production. Gere com: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60

# ── Segurança — API Key ───────────────────────────────────────────────────────
# Obrigatório quando APP_ENV=production. Gere com: openssl rand -hex 16
API_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ── Logging (DEBUG, INFO, WARNING, ERROR) ─────────────────────────────────────
LOG_LEVEL=INFO
